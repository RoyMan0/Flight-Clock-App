<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements, used only when signing with a Developer ID (notarization). -->
<plist version="1.0">
<dict>
  <!-- Python loads extension modules that aren't signed by the same team -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Now Playing asks the Music app for the current song -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
</dict>
</plist>
